# Copy this file to .env.local for local development. Never commit .env.local.
# On Vercel, set the same variables in Project Settings > Environment Variables.

NEXTAUTH_URL=http://localhost:3000
# Any long random string, e.g. the output of: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth client: follow docs/google-oauth.md. Only emails in members.json can upload.
GOOGLE_ID=
GOOGLE_SECRET=

# Fine-grained GitHub token, this repository only, "Contents: Read and write".
# The server commits every upload with it. It never reaches the browser.
GITHUB_UPLOAD_TOKEN=
