# Copy this file to .env for local development. Never commit .env.
# On Vercel, set the same variables in Project Settings > Environment Variables.
# Step-by-step help: docs/email-sign-in.md

# Signs sign-in links and cookies. A long random string; this prints one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Anyone who has it can sign in as anyone. Use a different one on Vercel.
AUTH_SECRET=

# The live site address, e.g. https://icdms.vercel.app. Sign-in links point here. Leave empty locally.
SITE_URL=

# The email account that sends sign-in links. Gmail: smtp.gmail.com, 465, the address, and an app password.
# Leave SMTP_HOST empty locally to have the link printed in the terminal instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Fine-grained GitHub token, this repository only, "Contents: Read and write".
# The server commits every upload with it. It never reaches the browser.
GITHUB_UPLOAD_TOKEN=
